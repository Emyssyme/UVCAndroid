<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context="com.herohan.uvcapp.activity.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.Usbvideo.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.Usbvideo.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.serenegiant.widget.AspectRatioTextureView
            android:id="@+id/viewMainPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignWithParentIfMissing="true"
            android:layout_centerInParent="true"
            android:visibility="invisible" />

        <!-- Quick AWB/AE/AF controls (always visible) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/internal_camera_quick_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:contentPadding="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnQuickAe"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AE Auto"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="4dp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnQuickAwb"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AWB Auto"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="4dp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnQuickAf"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AF Auto"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- tap-to-focus marker -->
        <View
            android:id="@+id/tap_focus_marker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="0dp"
            android:visibility="gone"
            android:background="@drawable/tap_focus_marker" />

        <!-- tally indicator circle -->
        <View
            android:id="@+id/tally_indicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="8dp"
            android:background="@drawable/tally_circle" />

        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.5"
                app:srcCompat="@drawable/ic_action_usb"
                app:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvConnectUSBCameraTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/main_connect_usb_tip"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:alpha="0.8" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="8dp"
            android:text="@string/stream_status_inactive"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:background="#55000000"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvVideoRecordTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:drawableLeft="@drawable/ic_record_red_dot"
            android:drawablePadding="5dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="99:99:99" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/internal_camera_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_transparent"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="360dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvInternalCameraControlsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Internal Camera Controls"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:alignmentMode="alignMargins"
                        android:useDefaultMargins="false">

                        <!-- Column 1: Zoom, ISO, White Balance -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Zoom"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvInternalZoomValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.0x"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seekbarInternalZoom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="ISO"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvInternalIsoValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seekbarInternalIso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:id="@+id/rowInternalKelvin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="8dp"
                                android:visibility="gone">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="WB (K)"
                                        android:textColor="?android:attr/textColorPrimary"
                                        android:textSize="12sp" />
                                    <TextView
                                        android:id="@+id/tvInternalKelvinValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="4500K"
                                        android:textColor="?android:attr/textColorPrimary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                                <SeekBar
                                    android:id="@+id/seekbarInternalKelvin"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Column 2: Exposure, Focus, Shutter -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:id="@+id/tvInternalExposureMode"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="AE: Auto"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvInternalExposureValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="EV: 0"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seekbarInternalExposure"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Focus"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvInternalFocusValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="infinity"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seekbarInternalFocus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Shutter"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvInternalExposureTimeValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1/100"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seekbarInternalExposureTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </GridLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <Button
                            android:id="@+id/btnInternalExposureLock"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Exposure Lock"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            app:strokeColor="?android:attr/textColorPrimary" />

                        <Button
                            android:id="@+id/btnInternalFocusLock"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Focus Lock"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            app:strokeColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnInternalAeToggle"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="AE Auto"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnInternalAwbToggle"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="AWB Auto"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnInternalAfToggle"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="AF Auto"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/internal_camera_bottom_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#4D888888">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnBottomSelectCamera"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="CAM"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnBottomExposure"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="EV"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnBottomExposureLock"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="EV-L"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="?attr/colorPrimary" />

                <Button
                    android:id="@+id/btnBottomAfMode"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="AF"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnBottomFocusLock"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="AF-L"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="?attr/colorPrimary" />

                <Button
                    android:id="@+id/btnBottomFlash"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="FL"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnBottomWhiteBalance"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="WB"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabVideo"
            style="@style/MainFloatingActionButton"
            android:layout_above="@id/fabPicture"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_marginBottom="16dp"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_switch_video" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPicture"
            style="@style/MainFloatingActionButton"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/fab_margin"
            android:layout_marginBottom="16dp"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_switch_camera" />
    </RelativeLayout>
</LinearLayout>